# ==============================================================================
# Kubernetes Secret Template for Clerk Authentication & API Secrets
# Copy this file to secret.yaml and populate actual base64 encoded values:
#   echo -n "pk_test_..." | base64
#   echo -n "sk_test_..." | base64
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: stoneflow-secrets
  namespace: stoneflow
  labels:
    app: stoneflow
type: Opaque
stringData:
  VITE_CLERK_PUBLISHABLE_KEY: "pk_test_YOUR_CLERK_PUBLISHABLE_KEY"
  CLERK_SECRET_KEY: "sk_test_YOUR_CLERK_SECRET_KEY"
  GEMINI_API_KEY: "YOUR_GEMINI_API_KEY"
  SMTP_USER: ""
  SMTP_PASS: ""
